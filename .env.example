ADMIN_PASSWORD=replace-with-a-long-organizer-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
NODE_ENV=development
# For online hosting: set HOST=0.0.0.0, NODE_ENV=production,
# APP_ORIGIN=https://your-domain.example and DATA_DIR to a persistent directory.
# Set TRUST_PROXY=1 only when exactly one trusted reverse proxy fronts the app.
